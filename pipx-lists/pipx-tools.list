# ==============================================================================
# pipx-tools.list: Python Security Tools (Managed via pipx in Isolated Envs)
# ==============================================================================
# Instructions:
#  - To DISABLE a tool: prefix with '#' (e.g., # arjun)
#  - To REMOVE a tool:  delete the line
#  - To ADD a tool:     add PyPI package name or git URL on a new line
#  - Inline comments with '#' are fully supported
# ==============================================================================

# --- Active Directory & Network Protocol Auditing ---
netexec @ git+https://github.com/Pennyw0rth/NetExec@c7dc286ba65daf10402cdc470e531b84e6d3d911  # Modern network execution and AD exploitation tool (NetExec / nxc), pinned to v1.5.1 tag commit c7dc286 (2026-02-23)
impacket==0.13.1            # Network protocol tools suite (secretsdump, psexec, wmiexec, etc.), pinned 0.13.1 (2026-05-19)
certipy-ad==5.1.0           # Active Directory Certificate Services (AD CS) enumeration and abuse, pinned 5.1.0 (2026-06-23; needs Python >= 3.12)
bloodhound-ce==1.9.1        # Python-based ingestor/collector for BloodHound Community Edition, pinned 1.9.1 (2025-10-24)
enum4linux-ng @ git+https://github.com/cddmp/enum4linux-ng@v1.3.10  # Windows/Samba enumeration, pinned to the Kali-shipped 1.3.10 (needs samba-client/samba-common-tools)

# --- Web Application Testing & Reconnaissance ---
sqlmap==1.10.11             # Automatic SQL injection and database takeover engine, pinned 1.10.11 (2026-10-30)
mitmproxy==12.3.1           # Interactive, SSL/TLS-capable intercepting HTTP proxy, pinned 12.3.1 (2026-10-25; needs Python >= 3.12)
arjun==2.2.7                # HTTP parameter discovery suite, pinned 2.2.7 (2024-11-03)
dirsearch==0.5.0            # Advanced web path brute-forcer, pinned 0.5.0 (2026-08-19; needs Python >= 3.11)
sublist3r==1.0              # Fast OSINT subdomain discovery tool, pinned 1.0 (2020-10-21; upstream dormant — takeover-risk watch)
updog==2.0.1                # Modern file-sharing HTTP/S web server with upload and HTTP basic auth, pinned 2.0.1 (2025-11-16; needs Python >= 3.11, < 4.0)

# --- Exploit Development & CTF ---
pwntools==4.15.0            # CTF framework and exploit development library, pinned 4.15.0 (2025-10-12)
