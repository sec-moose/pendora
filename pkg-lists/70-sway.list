# ==============================================================================
# 70-sway.list: Sway Wayland Tiling Compositor & Desktop Dependencies
# ==============================================================================
# Instructions:
#  - Installed when using --sway, -W, --server, -S, or --all
#  - Excluded when using --basic
#  - 100% native official Fedora RPM packages (no COPR required)
#  - noctalia-greeter (display manager UI) is built from upstream in --server mode;
#    everything in this file installs from official Fedora repositories
#  - Inline comments with '#' are fully supported
# ==============================================================================

# --- Wayland Tiling Compositor & Portals ---
sway                        # i3-compatible Wayland tiling compositor
xdg-desktop-portal-wlr      # Desktop portal backend for wlroots/sway screensharing
xdg-desktop-portal-gtk      # GTK desktop portal fallback

# --- Desktop Shell & UI Components ---
noctalia                    # Wayland desktop shell (bar, launcher, control center)
rofi                        # Window switcher and application runner
swaybg                      # Wallpaper renderer for sway 'output * bg' (Fedora sway does not require it)

# --- Screen Capture & Utilities ---
grim                        # Screenshot utility for Wayland / wlroots
slurp                       # Region selection tool for Wayland (used by grim)
nautilus                    # GNOME file manager
# --- Dynamic Window Opacity & IPC ---
python3-i3ipc               # Python IPC library for Sway focus-based opacity daemon

# --- SPICE VM Clipboard Integration & Xwayland ---
xorg-x11-server-Xwayland    # Xwayland server enabling X11 compatibility in Sway
spice-vdagent               # SPICE guest agent daemon for QEMU/KVM virtual machines
python3-gobject             # Python GObject introspection for GTK clipboard bridge
gtk3                        # GTK3 toolkit library used by SPICE clipboard bridge

# --- Session Runtime Parity (Fedora Server minimal; sway audit 2026-10-22) ---
dbus-tools                  # dbus-update-activation-environment for portal environment (sway config:9)
lxqt-policykit              # Graphical polkit authentication agent (privilege prompts hang without it on minimal)
firefox                     # Browser bound to $mod+b (sway config:98); absent from every other list
pipewire                    # Audio/screenshare daemon; hard requirement of the Noctalia bar
wireplumber                 # PipeWire session manager (Noctalia only pulls wireplumber-libs transitively)
gnome-keyring               # Secret portal backend per xdg-desktop-portal sway-portals.conf

# --- Display Manager (greetd stack for --server phase 1) ---
greetd                      # Minimal Wayland-native display manager (greeter-agnostic session harness)
tuigreet                    # Terminal greeter; configured fallback when noctalia-greeter is unavailable
